# Backend (Node) environment variables

# Stripe (required for PaymentSheet + webhook)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional; must match your Stripe account/API settings
STRIPE_API_VERSION=2024-06-20

# Optional constraints
MAX_QTY_PER_ITEM=10

# Optional email invites (AWS SES)
SES_SEND_INVITES=false
AWS_REGION=us-east-1
SES_FROM_EMAIL=you@yourdomain.com

# Optional MongoDB persistence
# MONGODB_URI=mongodb+srv://...
# MONGODB_DB=godash
